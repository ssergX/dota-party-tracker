# Telegram bot token from @BotFather
BOT_TOKEN=123456:your-token-here

# Optional: OpenDota API key for higher rate limits (works without it too)
# OPENDOTA_API_KEY=

# Optional overrides
# DB_PATH=mmrbot.db
# DEFAULT_DIGEST_HOUR=10
# DEFAULT_TZ=Europe/Moscow
# DEFAULT_MMR_STEP=25
# BACKUP_KEEP=7   # сколько суточных копий БД хранить в <папка БД>/backups (0 — выключить)

# Optional: Stratz API key (позиция/роль/IMP по матчам; без него работает на OpenDota)
# STRATZ_API_KEY=
# Experimental (скрыто): Steam Web API key — оповещения «зашёл в Dota 2»; без ключа выключены
# STEAM_API_KEY=
# OPENDOTA_MIN_INTERVAL=1.1   # пауза между запросами к OpenDota, сек (с ключом по умолчанию 0.25)
# OPENDOTA_BURST=5            # сколько запросов можно отправить подряд без паузы (1 — строго по одному)
